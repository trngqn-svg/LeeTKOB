                  "status": 400,
                  "instance": "/labs/lab-7f3c2a/publish"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem401Unauthenticated"
          },
          "403": {
            "description": "Caller is not a TA (`https://leetkob.example/problems/forbidden-role` — `Only TAs may publish marks`)",
