              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Problem" },
                "example": {
                  "type": "https://leetkob.example/problems/forbidden-role",
                  "title": "Only TAs may publish marks",
                  "status": 403,
                  "instance": "/labs/lab-7f3c2a/publish"
                }
              }
            }
          },
          "404": {
