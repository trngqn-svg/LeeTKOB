    "/labs/{labId}/publish": {
      "post": {
        "summary": "Publish marks for a lab",
        "description": "Who may call it: `ta` assigned to the lab's class only. `student` or `admin` gets `forbidden-role` (403). Non-member gets `lab-not-found` (404). Idempotent via `Idempotency-Key`.",
        "security": [{ "bearer": [] }],
        "parameters": [
          {
            "name": "labId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "example": "publish-power-mod-1",
            "description": "1-64 characters from A-Z, a-z, 0-9, _, -."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["confirm"],
                "additionalProperties": false,
                "properties": {
                  "confirm": { "type": "boolean", "enum": [true] },
                  "note": { "type": "string", "maxLength": 500 }
                }
              },
              "example": {
                "confirm": true,
                "note": "Modular Exponentiation lab, reviewed"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lab was already published; returns the existing publication",
            "content": {
              "application/json": {
                "example": {
                  "labId": "lab-7f3c2a",
                  "status": "published",
                  "publishedAt": "2026-11-26T14:03:00.000Z",
                  "publishedBy": "u-ta-1",
                  "marksPublished": 1,
                  "note": "Modular Exponentiation lab, reviewed"
                }
              }
            }
          },
          "201": {
            "description": "Lab published by this call",
