# Copy to .env and fill in. Never commit .env.
# HTTP server
PORT=
HOST=
# Model provider (used from PA#3; never passed into the sandbox)
LLM_API_KEY=
LLM_MODEL=
MODEL_OFF=
MODEL_TIMEOUT_MS=
# Database (SQLite file; the folder is git-ignored)
DB_PATH=
# Password of the seeded test accounts (npm run db:seed). Required on the deployment.
SEED_PASSWORD=
# Judge worker (npm run worker). Empty means the default of docs/ARCHITECTURE.md, section 2.4.
WORKER_ID=
LEASE_SECONDS=
MAX_ATTEMPTS=
# The sandbox image the worker runs submissions in (built from docker/sandbox/).
SANDBOX_IMAGE=
