# Caddy ends HTTPS for the public name and forwards to the API (docs/DEPLOYMENT.md,
# section 4). It gets and renews the certificate by itself; DOMAIN comes from
# deploy/compose.yaml.
{$DOMAIN} {
	encode gzip
	header -Server

	redir /docs /docs/
	handle /docs/* {
		root * /srv
		file_server
		header Content-Security-Policy "default-src 'none'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
	}

	reverse_proxy api:3000
}
