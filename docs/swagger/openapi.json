              "application/json": {
                "example": {
                  "labId": "lab-7f3c2a",
                  "status": "published",
                  "publishedAt": "2026-11-26T14:03:00.000Z",
                  "publishedBy": "u-ta-1",
                  "marksPublished": 1,
                  "note": "Modular Exponentiation lab, reviewed"
                }
              }
            }
          },
          "400": {
