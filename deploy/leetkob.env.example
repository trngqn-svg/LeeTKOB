# What /etc/leetkob/leetkob.env holds on the VM (deploy/compose.yaml). Copy it there,
# fill it in, and make it readable by root only:
#   sudo install -D --mode 600 --owner root deploy/leetkob.env.example /etc/leetkob/leetkob.env
# Never commit the filled file.

# The public name Caddy gets a certificate for.
DOMAIN=leetkob-hcmus.eastasia.cloudapp.azure.com
# The password of the test accounts of PA3.md (npm run db:seed). They hold no real data.
SEED_PASSWORD=
# The model, for the worker only.
LLM_API_KEY=
LLM_MODEL=
# The group that owns /var/run/docker.sock on the VM: getent group docker | cut -d: -f3
DOCKER_GID=
