    "/review-items/{itemId}/decision": {
      "post": {
        "summary": "Decide one review item",
        "description": "Who may call it: `ta` assigned to the item's class only. `student` or `admin` gets `role-not-allowed` (403). Non-member gets `review-item-not-found` (404).",
        "security": [{ "bearer": [] }],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["finalVerdict"],
                "additionalProperties": false,
                "properties": {
                  "finalVerdict": {
                    "type": "string",
                    "enum": ["pass", "violation"]
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 20,
                    "items": { "$ref": "#/components/schemas/EvidenceLine" },
                    "description": "Required and non-empty when finalVerdict is `violation`; absent or empty when `pass`."
                  },
                  "note": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 1000
                  }
                }
              },
              "example": {
                "finalVerdict": "pass",
                "note": "Verified binary exponentiation in loop."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item decided (or replayed with the same decision)",
            "content": {
              "application/json": {
                "example": {
                  "reviewItem": {
                    "id": 41,
                    "submissionId": "sub-91d0e4",
                    "constraintCode": "C1",
                    "reason": "sample",
                    "status": "reviewed",
                    "finalVerdict": "pass",
                    "finalEvidence": null,
                    "note": "Verified binary exponentiation in loop.",
                    "reviewedBy": "u-ta-1",
                    "reviewedAt": "2026-11-26T10:02:00.000Z"
                  },
                  "pendingReviews": 0
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem401Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Problem403RoleNotAllowed"
          },
          "404": {
            "description": "Review item not found or TA not assigned (`https://leetkob.example/problems/review-item-not-found` — `Review item not found`)",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Problem" },
                "example": {
                  "type": "https://leetkob.example/problems/review-item-not-found",
                  "title": "Review item not found",
                  "status": 404,
                  "instance": "/review-items/41/decision"
